# TomTom Routing API key (free tier: https://developer.tomtom.com).
# Leave empty to run the API with the built-in "mock" provider.
TOMTOM_API_KEY=

# Port for the Express API server. Optional: the dev scripts run it on 8787 (--port 8787), and the
# Vite dev server proxies /api to API_PORT (default 8787). Set it here to move both together.
# Lookup order in src/api/server.ts: API_PORT, then --port <n>, then PORT (production hosts), then 8787.
# Don't use PORT for this in dev: dev tools often set PORT for the Vite server.
# API_PORT=8787

# Route calculations allowed per client per minute (place search gets four times as many). 0 = no limit.
# RATE_LIMIT_PER_MINUTE=30

# How long an identical route calculation is reused, in seconds. Saves routing quota when only the
# price month changes or Calculate is pressed again. 0 = always ask the routing provider.
# ROUTE_CACHE_SECONDS=90

# Other websites allowed to call the API from a browser (comma-separated origins). Leave unset when
# the frontend is served by this server or through the Vite proxy: both are same-origin.
# CORS_ORIGINS=https://routes.example

# Behind a reverse proxy, set this so the rate limit sees the real client address
# (Express "trust proxy": a hop count such as 1, or true).
# TRUST_PROXY=1

# Raster tile URL template for the MapLibre base map (exposed to the frontend).
# Respect the tile provider's usage policy; swap for your own tile server in production.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
