# TomTom Routing API key (free tier: https://developer.tomtom.com).
# Leave empty to run the API with the built-in "mock" provider.
TOMTOM_API_KEY=66afa4d4-86ca-4520-8cec-11a8885931e2

# Port for the Express API server. Optional: the dev scripts run it on 8787 (--port 8787), and the
# Vite dev server proxies /api to API_PORT (default 8787). Set it here to move both together.
# Lookup order in src/api/server.ts: API_PORT, then --port <n>, then PORT (production hosts), then 8787.
# Don't use PORT for this in dev: dev tools often set PORT for the Vite server.
# API_PORT=8787

# Raster tile URL template for the MapLibre base map (exposed to the frontend).
# Respect the tile provider's usage policy; swap for your own tile server in production.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
